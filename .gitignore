# ── Secrets ──────────────────────────────────────────────────────────────────
# `.env` alone does not match `.env.bak`, `.env.local` and friends, and a
# backup of it carries every API key and the wallet private key. Ignore the
# whole family, then re-admit the one file that is meant to be public.
.env
.env.*
!.env.example

# Anything that reads like a credential dump.
*credentials*.txt
*secrets*
*.pem
*.key
*.p12
*.pfx

# ── Python ───────────────────────────────────────────────────────────────────
venv/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# ── Runtime output ───────────────────────────────────────────────────────────
# Logs, and the QR images the app writes as it runs. Certificate QRs are
# regenerated on every verification request; receipt QRs belong to a database
# that a fresh clone will not have. Neither is source.
*.log
logs/
static/certificates/
static/receipts/
static/uploads/
# Written when the app is launched from inside src/ rather than the repo root,
# because qr_gen resolves its output path relative to the working directory.
src/static/certificates/
src/static/receipts/
src/static/uploads/
src/uploads/
uploads/

# ── Database ─────────────────────────────────────────────────────────────────
pgdata/
*.sql
!scripts/schema.sql
*.sqlite
*.sqlite3
*.db
*.dump

# ── Editor and OS noise ──────────────────────────────────────────────────────
# `~$...` files are the lock files Word leaves behind while a document is open.
~$*
*.tmp
*.bak
*.orig
*.rej
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# ── Local dev environment (machine-specific, not part of the app) ────────────
docker-compose.yml
LINUX_SETUP.md
Handoff.md
handoffs/

# ── Local-only maintenance/seed scripts (not for the repo) ───────────────────
create_demo_accounts.py
scripts/create_admin.py
scripts/fix_receipt.py
scripts/seed_all_data.py
scripts/seed_registrations.py
scripts/seed_users.py
scripts/_guard.py

# ── IDE / agent config ───────────────────────────────────────────────────────
.claude/
CLAUDE.md
.impeccable/

# ── Generated artefacts ──────────────────────────────────────────────────────
# graphify knowledge graph (regenerate with `graphify update .`)
graphify-out/

# ── Non-essential (docs, planning material, dev-only scripts, stray junk) ────
non_essential/

# Skill lockfile: local to this machine's skill installs, not app source.
skills-lock.json

# Claude Code agent working notes — local scratch, not app source.
memory/
