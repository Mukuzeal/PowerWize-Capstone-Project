# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres

# Flask
SECRET_KEY=your-secret-key-here

# AI (Groq)
AI_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# LM Studio (optional local AI)
# Use 127.0.0.1, NOT localhost. On Windows, localhost resolves to IPv6 ::1
# first; LM Studio listens on IPv4 only, so every request waits ~2s for the
# IPv6 attempt to fail before falling back. Measured 2046ms vs 3.2ms per
# call -- and a Solara turn makes 2-3 of them. See docs/RAG_SETUP.md.
LM_STUDIO_URL=http://127.0.0.1:1234
LM_STUDIO_MODEL=local-model

# Solar RAG (retrieval-augmented Solara chat) — see docs/RAG_SETUP.md
# Embeddings are independent of TEXT_PROVIDER: local_cpu runs on CPU (fastembed/
# ONNX, no GPU) so retrieval works even when LM Studio isn't running.
EMBED_PROVIDER=local_cpu
EMBED_MODEL=BAAI/bge-small-en-v1.5
# Tuned from scripts/rag_eval.py's per-category score output — see the
# comment above RAG_MIN_SCORE in src/rag/retriever.py for the reasoning.
RAG_MIN_SCORE=0.55
# Seconds to reuse the fetched+normalized chunk matrix before re-reading
# rag_chunks. Opening a connection and re-parsing every REAL[] was ~57ms of a
# ~62ms retrieve(). 0 disables the cache — use that while rebuilding an index
# you're hand-checking, since build_rag_index.py is a separate process and a
# live app serves the old vectors until the TTL lapses.
RAG_CACHE_TTL=300
# 1 = if LM Studio fails, retry once through Groq (PII-stripped context) before
# giving up. Applies to both the chat and the final recommendation write-up.
RAG_GROQ_FALLBACK=0

# PayMongo
PAYMONGO_SECRET_KEY=sk_live_...
PAYMONGO_PUBLIC_KEY=pk_live_...
PAYMONGO_WEBHOOK_SECRET=whsec_...
TRAINING_FEE=5000

# Email (SMTP)
EMAIL_USER=your@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM_NAME=EnergyWize

# Blockchain (Polygon)
POLYGON_NETWORK=amoy
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
MAINNET_RPC_URL=https://polygon-rpc.com
CHAIN_ID_AMOY=80002
CHAIN_ID_MAINNET=137
SYSTEM_WALLET_PRIVATE_KEY=your-private-key
SYSTEM_WALLET_ADDRESS=your-wallet-address
